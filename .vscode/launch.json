{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "steamfresh",
            "request": "launch",
            "type": "dart",
            "args": [
                "--web-hostname=localhost",
                "--web-port=8080"
            ]
        },
        {
            "name": "steamfresh (chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--web-hostname=localhost",
                "--web-port=8080"
            ]
        },
        {
            "name": "steamfresh (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--web-hostname=localhost",
                "--web-port=8080"
            ]
        },
        {
            "name": "steamfresh (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--web-hostname=localhost",
                "--web-port=8080"
            ]
        }
    ]
}
